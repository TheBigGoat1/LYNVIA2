# Copy to `.env.local` and fill in. Never commit real secrets.
# Docs: README.md (Firebase bootstrap, Stripe webhooks).

# -----------------------------------------------------------------------------
# Firebase — client (browser). From Firebase Console → Project settings → Your apps → Web app
# Realtime Database URL (*.firebaseio.com) is NOT used by this app; we use Cloud Firestore.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional (Analytics)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-only: Firebase Admin (API routes, scripts). JSON string of the service account key.
# FIREBASE_PROJECT_ID=   # optional override; otherwise taken from the JSON
# FIREBASE_ADMIN_SDK_JSON={"type":"service_account",...}

# -----------------------------------------------------------------------------
# Google Gemini (Legal Assistant, Genkit flows: legal-qa, document generator AI, etc.)
# Get a key: https://aistudio.google.com/apikey — paste into ONE of these (first match wins in code):
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_GENAI_API_KEY=

# -----------------------------------------------------------------------------
# Payments — true = no Stripe; orders/subscriptions/wallet still update in Firestore (functional QA).
# Set to false (or remove) before production card billing.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PAYMENTS_DISABLED=true

# -----------------------------------------------------------------------------
# Stripe — only required when NEXT_PUBLIC_PAYMENTS_DISABLED is not true
# - Secret: Stripe Dashboard → Developers → API keys → Secret key (sk_test_… or sk_live_…)
# - Publishable: same page, Publishable key (pk_test_… / pk_live_…)
# - Put them in .env.local (this file is only a template). Restart `npm run dev` after any change.
# - Webhooks: `stripe listen --forward-to localhost:9002/api/webhooks/stripe` → copy STRIPE_WEBHOOK_SECRET from CLI
# Optional alias if you prefer one name: STRIPE_KEY=sk_test_… (same as STRIPE_SECRET_KEY)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# App URL for Checkout success/cancel redirects
NEXT_PUBLIC_BASE_URL=http://localhost:9002

# -----------------------------------------------------------------------------
# App-level QA mode (NOT Stripe’s test mode): skips real Checkout and marks orders paid in Firestore
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_TEST_MODE=true
